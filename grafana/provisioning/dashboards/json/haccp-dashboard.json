{
  "title": "HACCP Compliance Monitoring",
  "uid": "haccp-monitoring",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Relevance distribution",
      "type": "piechart",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "postgres", "uid": "postgres-haccp" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-haccp" },
          "rawSql": "SELECT relevance, COUNT(*) AS count FROM conversations GROUP BY relevance",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Feedback",
      "type": "piechart",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "postgres", "uid": "postgres-haccp" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-haccp" },
          "rawSql": "SELECT CASE WHEN feedback = 1 THEN 'Helpful' ELSE 'Not helpful' END AS label, COUNT(*) AS count FROM feedback GROUP BY label",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Questions per day",
      "type": "barchart",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "datasource": { "type": "postgres", "uid": "postgres-haccp" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-haccp" },
          "rawSql": "SELECT date_trunc('day', timestamp) AS time, COUNT(*) AS questions FROM conversations GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Response time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "postgres-haccp" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-haccp" },
          "rawSql": "SELECT timestamp AS time, response_time FROM conversations ORDER BY timestamp",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tokens per question",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "postgres-haccp" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-haccp" },
          "rawSql": "SELECT timestamp AS time, total_tokens + eval_total_tokens AS total_tokens FROM conversations ORDER BY timestamp",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Last 10 conversations",
      "type": "table",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 9 },
      "datasource": { "type": "postgres", "uid": "postgres-haccp" },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres-haccp" },
          "rawSql": "SELECT timestamp, question, relevance, response_time FROM conversations ORDER BY timestamp DESC LIMIT 10",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ]
    }
  ]
}
